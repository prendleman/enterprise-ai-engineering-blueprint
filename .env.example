# AI provider: mock | openai | anthropic
AI_PROVIDER=mock

# Only required when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Only required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Application
APP_ENV=local
LOG_LEVEL=INFO
TELEMETRY_DB_PATH=data/telemetry.db
CONFIG_DIR=config
HOST=0.0.0.0
API_PORT=8000
DASHBOARD_PORT=8501

# Demo / productivity model (simulated estimates)
DEFAULT_MANUAL_MINUTES=75
